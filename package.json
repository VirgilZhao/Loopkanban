{
  "name": "openkanban-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @openkanban/web exec tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "m0": "node --experimental-strip-types packages/host/src/bin/m0.ts",
    "build:web": "pnpm --filter @openkanban/web run build",
    "dev": "node --experimental-strip-types packages/host/src/bin/openkanban.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
